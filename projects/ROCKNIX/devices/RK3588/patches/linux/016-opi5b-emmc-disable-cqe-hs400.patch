--- a/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5b.dts	2026-06-13 19:36:28.746360178 -0300
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5b.dts	2026-06-13 19:36:28.762152303 -0300
@@ -15,6 +15,17 @@
 
 &sdhci {
 	status = "okay";
+
+	/* OPi 5B eMMC stability: HS400-Enhanced-Strobe + Command Queue Engine
+	 * trigger "running CQE recovery" storms on this board that silently
+	 * drop writes (e.g. cloning/large copies to internal eMMC fail). Disable
+	 * CQE and HS400; fall back to HS200 at a conservative clock. Costs some
+	 * throughput, gains reliable writes. */
+	/delete-property/ supports-cqe;
+	/delete-property/ mmc-hs400-enhanced-strobe;
+	/delete-property/ mmc-hs400-1_8v;
+	no-mmc-hs400;
+	max-frequency = <150000000>;
 };
 
