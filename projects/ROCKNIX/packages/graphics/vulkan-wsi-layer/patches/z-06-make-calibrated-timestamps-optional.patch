+VkResult get_calibrateable_time_domains(VkPhysicalDevice physical_device, uint32_t *count, VkTimeDomainKHR *domains)
+{
+   auto &instance_data = layer::instance_private_data::get(physical_device);
+   uint32_t ext_count = 0;
+   TRY(instance_data.disp.EnumerateDeviceExtensionProperties(physical_device, nullptr, &ext_count, nullptr));
+   util::vector<VkExtensionProperties> properties{ util::allocator(instance_data.get_allocator(),
+                                                                   VK_SYSTEM_ALLOCATION_SCOPE_COMMAND) };
+   if (!properties.try_resize(ext_count))
+   {
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   TRY(instance_data.disp.EnumerateDeviceExtensionProperties(physical_device, nullptr, &ext_count, properties.data()));
+
+   const bool has_khr = std::find_if(properties.begin(), properties.end(), [](const VkExtensionProperties &ext) {
+                           return strcmp(ext.extensionName, VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME) == 0;
+                        }) != properties.end();
+   if (has_khr)
+   {
+      return instance_data.disp.GetPhysicalDeviceCalibrateableTimeDomainsKHR(physical_device, count, domains);
+   }
+   return instance_data.disp.GetPhysicalDeviceCalibrateableTimeDomainsEXT(physical_device, count, domains);
+}
